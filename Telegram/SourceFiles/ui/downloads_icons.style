using "ui/colors.palette";
using "ui/widgets/widgets.style";

menuIconDownloads: icon {{ "menu/download", menuIconColor }};

downloadsTabAll: icon {{ "downloads/download_small", menuIconColor }};
downloadsTabPhotos: icon {{ "downloads/photo", menuIconColor }};
downloadsTabVideos: icon {{ "downloads/video", menuIconColor }};
downloadsTabFiles: icon {{ "downloads/document", menuIconColor }};
downloadsTabMusic: icon {{ "downloads/music", menuIconColor }};
downloadsTabLinks: icon {{ "downloads/link", menuIconColor }};
downloadsTabVoice: icon {{ "downloads/mic", menuIconColor }};
downloadsActionSave: icon {{ "downloads/download_small", menuIconColor }};
downloadsActionFolder: icon {{ "downloads/openinfolder", menuIconColor }};
downloadsActionTrash: icon {{ "downloads/trash", menuIconColor }};
downloadsSearch: icon {{ "downloads/search", menuIconColor }};
downloadsSort: icon {{ "downloads/sort", menuIconColor }};
downloadsChevronDown: icon {{ "downloads/chevron_down", menuIconColor }};
downloadsViewGrid: icon {{ "downloads/tabel", menuIconColor }};
downloadsViewList: icon {{ "downloads/listview", menuIconColor }};
downloadsPause: icon {{ "downloads/pause", menuIconColor }};
downloadsCancel: icon {{ "downloads/cancel", menuIconColor }};
downloadsDetailDownload: icon {{ "downloads/download_small", menuIconColor }};
downloadsDetailForward: icon {{ "downloads/forward", menuIconColor }};
downloadsDetailRemove: icon {{ "downloads/trash", menuIconColor }};

downloadsRowHeight: 70px;
downloadsRowOuterPadding: 12px;
downloadsRowHorizontalPadding: 16px;
downloadsRowBorderWidth: 1px;
downloadsRowBorderFg: windowBg;
downloadsHeaderHeight: 56px;
downloadsHeaderPadding: 20px;
downloadsTabBarHeight: 44px;
downloadsTabBarPadding: 16px;
downloadsTabGap: 4px;
downloadsThumbnailSize: 44px;
downloadsThumbnailRadius: 8px;
downloadsBadgeHeight: 19px;
downloadsBadgePadding: 6px;
downloadsProgressHeight: 3px;
downloadsFooterHeight: 36px;
downloadsFooterPadding: 20px;
downloadsFooterDotSize: 8px;
downloadsSearchWidth: 240px;
downloadsSearchHeight: 33px;
downloadsSortButtonHeight: 30px;
downloadsViewToggleWidth: 64px;
downloadsViewToggleHeight: 32px;
downloadsSizeColumnWidth: 100px;
downloadsDateColumnWidth: 96px;
downloadsActionsColumnWidth: 96px;
downloadsProgressColumnWidth: 88px;
downloadsProgressGap: 50px;
downloadsColumnHeaderHeight: 28px;
downloadsRowStatusHeight: 16px;

// Grid (card) view layout — see DownloadsGridView.
downloadsCardGap: 12px;
downloadsCardHeight: 210px;
downloadsCardThumbnailHeight: 130px;
downloadsCardRadius: 12px;
downloadsCardMinWidth: 180px;
downloadsCardInfoPadH: 12px;
downloadsCardInfoPadV: 10px;
downloadsCardDocBoxSize: 52px;
downloadsCardDocBoxRadius: 8px;
downloadsCardDurationBadgeRadius: 4px;

// Grid detail panel (right-hand inspector shown on card selection).
downloadsDetailWidth: 260px;
downloadsDetailHeaderHeight: 44px;
downloadsDetailPadH: 16px;
downloadsDetailAbbrevBoxSize: 52px;
downloadsDetailAbbrevBoxRadius: 8px;
downloadsDetailRowHeight: 28px;
downloadsDetailButtonHeight: 38px;
downloadsDetailButtonGap: 6px;
downloadsDetailButtonRadius: 8px;

downloadsBadgeFont: font(11px semibold);
downloadsFileIconFont: font(9px semibold);

downloadsHeaderTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: windowFg;
}
downloadsHeaderSubtitle: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}
downloadsEmptyTitle: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: windowFg;
}
downloadsEmptySubtitle: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}
downloadsFooterCount: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowFg;
}

downloadsColumnHeader: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}
downloadsRowStatus: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}

downloadsRowName: FlatLabel(defaultFlatLabel) {
	style: semiboldTextStyle;
	textFg: windowFg;
}
downloadsRowSource: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}
downloadsRowSize: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}
downloadsRowDate: FlatLabel(defaultFlatLabel) {
	style: defaultTextStyle;
	textFg: windowSubTextFg;
}